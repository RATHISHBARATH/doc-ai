# Auth Service
JWT_SECRET=change_me_in_production
DATABASE_URL=postgres://docai:docai@postgres:5432/docai

# Gateway
RUST_LOG=info
AUTH_URL=http://auth:8000
COORDINATOR_URL=http://coordinator:8001

# Coordinator
